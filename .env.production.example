# Copy to your hosting dashboard (Vercel/Railway) — never commit real secrets.
# Run once locally: STRIPE_LIVE_SECRET_KEY=sk_live_... node scripts/setup-stripe-live.mjs
# That script registers the webhook and prints STRIPE_WEBHOOK_SECRET.

# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe LIVE ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ── Stripe Price IDs — pricing v3, single membership (live mode) ─────────────
# Create with `node --env-file=.env.production scripts/setup-stripe-live.mjs`
# and paste the printed IDs here. Both prices grant 20 high-resolution
# downloads per billing month; physical prints are charged separately.
STRIPE_PRICE_MEMBERSHIP_MONTHLY=price_1U8ZTSAiWsddNgTsl9wUxKbB  # $10/month
STRIPE_PRICE_MEMBERSHIP_ANNUAL=price_1U8ZTSAiWsddNgTsprnDpNMk   # $100/year

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://posterarmory.com

# ── Worker (separate Railway service — must match web app) ───────────────────
WORKER_CALLBACK_SECRET=

# ── Gelato — live fulfillment ────────────────────────────────────────────────
GELATO_API_KEY=
GELATO_WEBHOOK_SECRET=
GELATO_ORDER_MARKUP=1.5
GELATO_CURRENCY=USD
GELATO_ORDER_TYPE=order
# Webhook URL: https://posterarmory.com/api/gelato/webhook?token=<GELATO_WEBHOOK_SECRET>
GELATO_PRODUCT_UID_8X10_PORTRAIT=
GELATO_PRODUCT_UID_8X10_LANDSCAPE=
GELATO_PRODUCT_UID_12X16_PORTRAIT=
GELATO_PRODUCT_UID_12X16_LANDSCAPE=
GELATO_PRODUCT_UID_18X24_PORTRAIT=
GELATO_PRODUCT_UID_18X24_LANDSCAPE=

# ── Python CLI (worker service only) ─────────────────────────────────────────
PYTHON_EXECUTABLE=python3
POSTER_CLI_PATH=./create_map_poster.py
