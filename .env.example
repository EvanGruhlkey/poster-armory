# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Stripe Price IDs (pricing v2)
# Recurring subscriptions — use test IDs locally; live IDs in .env.production.example
STRIPE_PRICE_STARTER=price_...        # $10/mo — 5 downloads/month
STRIPE_PRICE_PRO=price_...            # $20/mo — unlimited downloads + commercial use
# One-time purchase
STRIPE_PRICE_SINGLE_DOWNLOAD=price_... # $9 one-time — 1 non-expiring download credit

# App — use https://posterarmory.com in production (see .env.production.example)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Python poster CLI
PYTHON_EXECUTABLE=python
POSTER_CLI_PATH=./create_map_poster.py

# Gelato physical fulfillment
# API key from https://dashboard.gelato.com (API Portal)
GELATO_API_KEY=
# Secret token appended to the Gelato webhook URL (?token=...) to authenticate
# inbound status webhooks: https://your-app/api/gelato/webhook?token=...
GELATO_WEBHOOK_SECRET=
# Retail multiplier applied to the Gelato base product price (>= 1). Default 1.5.
GELATO_ORDER_MARKUP=1.5
# ISO 4217 currency to charge/quote in. Default USD.
GELATO_CURRENCY=USD
# Set to "draft" while testing so orders land in the Gelato dashboard and never
# go to production. Set to "order" (or omit) for live fulfillment.
# Production: always use GELATO_ORDER_TYPE=order (see .env.production.example)
GELATO_ORDER_TYPE=draft
# Optional: override the Gelato product UID per size + orientation. Pull exact
# UIDs from your Gelato catalog. Format: GELATO_PRODUCT_UID_<SIZE>_<ORIENTATION>
# GELATO_PRODUCT_UID_8X10_PORTRAIT=
# GELATO_PRODUCT_UID_8X10_LANDSCAPE=
# GELATO_PRODUCT_UID_12X16_PORTRAIT=
# GELATO_PRODUCT_UID_12X16_LANDSCAPE=
# GELATO_PRODUCT_UID_18X24_PORTRAIT=
# GELATO_PRODUCT_UID_18X24_LANDSCAPE=
# GELATO_PRODUCT_UID_24X36_PORTRAIT=
# GELATO_PRODUCT_UID_24X36_LANDSCAPE=

# Shared secret so the render worker can notify the web app when a print job
# finishes (worker -> POST /api/internal/job-complete). Must match on both.
WORKER_CALLBACK_SECRET=
